<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="turtlebot_room">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>

      <update_rate>30.0</update_rate>
    </plugin>

    <model name="room_walls">
      <static>true</static>
      <link name="link">
        <visual name="north_wall">
          <pose>3 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 6 1</size></box></geometry>
        </visual>
        <collision name="north_wall_col">
          <pose>3 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 6 1</size></box></geometry>
        </collision>

        <visual name="south_wall">
          <pose>-3 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 6 1</size></box></geometry>
        </visual>
        <collision name="south_wall_col">
          <pose>-3 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 6 1</size></box></geometry>
        </collision>

        <visual name="east_wall">
          <pose>0 3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </visual>
        <collision name="east_wall_col">
          <pose>0 3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>

        <visual name="west_wall">
          <pose>0 -3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </visual>
        <collision name="west_wall_col">
          <pose>0 -3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="round_pillar">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.36</radius> 
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.36</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
  </world>
</sdf>